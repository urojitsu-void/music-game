{
  "name": "music-game-video",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "assets:game": "tsx src/render/generate-game-assets.ts",
    "play:build": "tsx src/play/build-pages.ts",
    "play": "tsx src/play/server-cli.ts",
    "data:deploy": "tsx src/play/data-deploy-cli.ts",
    "data:build": "node --env-file=.env.default --import tsx src/cli.ts data-build",
    "video:generate": "node --env-file=.env.default --import tsx src/cli.ts build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
